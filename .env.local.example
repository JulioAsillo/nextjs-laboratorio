# URL base del backend Python. Siempre localhost:8000 en local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Endpoint del reporte de aplicaciones.
NEXT_PUBLIC_HALLAZGOS_ENDPOINT=/hallazgos/apps

# Endpoint base para subir las fuentes manuales (Cargar Información).
# Se enviará POST a {API_BASE_URL}{UPLOAD_ENDPOINT}/{fuenteId}
NEXT_PUBLIC_UPLOAD_ENDPOINT=/cargar
